{
  "name": "pix-mcp",
  "version": "0.1.0",
  "description": "MCP server that bridges AI assistants with Pixelorama for pixel art creation",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pix-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "keywords": [
    "mcp",
    "pixelorama",
    "pixel-art",
    "ai",
    "drawing",
    "model-context-protocol"
  ],
  "author": "pix-MCP Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abidoo22/Pixelorama-MCP.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.0.0",
    "eslint": "^9.39.4",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.59.4"
  }
}
